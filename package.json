{
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "calcit --entry smoke-test js && node test-main.mjs && calcit js && yarn vite build --base=./",
    "check:deprecated": "calcit calcit.cirru analyze deprecated --summary-only --format json",
    "test:mathml": "calcit --entry smoke-test js && node test-main.mjs",
    "test:incremental": "calcit --entry perf-test js && node perf-test-main.mjs"
  },
  "dependencies": {
    "@calcit/procs": "^0.13.42",
    "cirru-color": "^0.2.4",
    "copy-text-to-clipboard": "^3.2.2",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "^8.0.14"
  }
}
